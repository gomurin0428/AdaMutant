library project AdaMutant_Core is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/core");
   for Object_Dir use "obj/core";
   for Library_Dir use "lib";
   for Library_Name use "adamutant";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnaty3abcefhiklnprt",
         "-g", "-O1");
      for Default_Switches ("C") use ("-Wall", "-Wextra", "-Werror", "-g", "-O1");
   end Compiler;

end AdaMutant_Core;
