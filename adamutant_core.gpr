library project AdaMutant_Core is

   --  Warnings stop the build unless this is "false".  The Alire manifest
   --  sets it to "false", so that a compiler with a new warning can still
   --  build a published release.
   type Yes_No is ("true", "false");
   Warnings_As_Errors : Yes_No :=
     external ("ADAMUTANT_WARNINGS_AS_ERRORS", "true");

   Ada_Switches :=
     ("-gnat2022", "-gnatwa", "-gnata", "-gnaty3abcefhiklnprt", "-g", "-O1");
   C_Switches := ("-Wall", "-Wextra", "-g", "-O1");

   case Warnings_As_Errors is
      when "true" =>
         Ada_Switches := Ada_Switches & ("-gnatwe");
         C_Switches := C_Switches & ("-Werror");
      when "false" =>
         null;
   end case;

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/core");
   for Object_Dir use "obj/core";
   for Library_Dir use "lib";
   for Library_Name use "adamutant";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use Ada_Switches;
      for Default_Switches ("C") use C_Switches;
   end Compiler;

end AdaMutant_Core;
